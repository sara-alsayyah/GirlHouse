# Copy these values into your hosting provider's secret manager.
SECRET_KEY=replace-with-a-long-random-secret-at-least-50-characters
DEBUG=False
ALLOWED_HOSTS=127.0.0.1,localhost
FRONTEND_BASE_URL=https://girlhouse.shop
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://girlhouse.shop,https://www.girlhouse.shop
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
DB_ENGINE=django.db.backends.postgresql
DB_NAME=girlhouse_db
DB_USER=girlhouse
DB_PASSWORD=replace-with-a-strong-database-password
DB_HOST=database-host
DB_PORT=5432
REDIS_URL=redis://redis-host:6379/0
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=replace-with-smtp-username
EMAIL_HOST_PASSWORD=replace-with-smtp-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=orders@example.com
